{
  "sourceLanguage" : "en",
  "strings" : {
    "AddFolder.Message" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose folders with music to show in the sidebar."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サイドバーに表示する、音楽が入ったフォルダを選択してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사이드바에 표시할 음악 폴더를 선택하십시오."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chọn các thư mục chứa nhạc để hiển thị trong thanh bên."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择要在边栏中显示的音乐文件夹。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選擇要在側邊欄中顯示的音樂檔案夾。"
          }
        }
      }
    },
