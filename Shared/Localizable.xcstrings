    "FileBrowser.Tip.NoFiles.Text" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "variations" : {
            "device" : {
              "ipad" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "To add files to Melodee, open the Files app, navigate to 'On My iPad', and drop your files in the Melodee folder."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
