    "NowPlaying.Tip.Queue.Text" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To queue files for playback, swipe either left or right on a file. Swiping left will play the file after all other files in the queue, and swiping right will play the file immediately after the currently playing file."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "再生キューにファイルを追加するには、ファイルに左か右にスワイプしてください。\n左にスワイプすると、そのファイルが再生キューの最後のファイルの後に再生されます。\n右にスワイプすると、そのファイルが再生中のファイルの後に再生されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "재생을 위해 파일을 대기열에 추가하려면 오디오 파일 행을 왼쪽이나 오른쪽으로 스와이프하세요."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Để thêm tệp vào hàng đợi phát, vuốt sang trái hoặc phải trên hàng tệp âm thanh."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要将文件加入播放队列，请在音频文件行上向左或向右滑动。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要將檔案加入播放佇列，請在音訊檔案列上向左或向右滑動。"
          }
        }
      }
    },
    "NowPlaying.Tip.Queue.Title" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Queue Files for Playback"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "再生キューを使用する方法"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "재생을 위한 파일 대기열"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thêm tệp vào hàng đợi để phát"
