    "Onboarding.Feature.PlayAnything.Blurb" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MP3, WAV, FLAC, and many more formats — your whole library in one player."
          }
