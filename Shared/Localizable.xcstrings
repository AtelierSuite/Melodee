    "TagEditor.Section.Sorting.Footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Music apps use these to sort your library. For example, entering “Constant Moderato” in Sort Title sorts the track under C, whatever its title is."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ミュージックアプリでライブラリを並べ替えるときに使われます。例えば「タイトルの読み」に「Constant Moderato」と入力すると、タイトルにかかわらずCの項目に並びます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "음악 앱에서 보관함을 정렬할 때 사용됩니다. 예를 들어 제목 정렬에 “Constant Moderato”를 입력하면 제목과 관계없이 트랙이 C 항목에 정렬됩니다."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các ứng dụng nhạc dùng các trường này để sắp xếp thư viện. Ví dụ, nhập “Constant Moderato” vào Tiêu Đề (sắp xếp) sẽ xếp bài hát vào mục C, bất kể tiêu đề là gì."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音乐 App 会按这些内容对资料库进行排序。例如，在“标题排序”中输入“Constant Moderato”，无论标题是什么，该曲目都会排在 C 下。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音樂 App 會依這些內容排序資料庫。例如，在「標題排序」中輸入「Constant Moderato」，無論標題為何，該曲目都會排在 C 底下。"
          }
        }
      }
    },
