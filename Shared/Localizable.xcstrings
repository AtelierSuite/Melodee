    "BatchRename.Problem.InvalidName" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The new name cannot contain '/' or ':', or start with '.'."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新しい名前に「/」や「:」を含めたり、「.」で始めたりすることはできません。"
