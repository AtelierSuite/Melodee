        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "새 이름에는 '/' 또는 ':'를 포함하거나 '.'으로 시작할 수 없습니다."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
