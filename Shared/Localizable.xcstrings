    "TagEditor.Tokens.DashBack.Description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Represents the text in the file name after the '-' (dash) symbol.\nFor example, \"Rick Astley - Never Gonna Give You Up.mp3\" will result in \"Never Gonna Give You Up\"."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ファイル名にある「-」の後ろのテキストに変換します。\n例えば、「さユり - 花の塔.mp3」の場合、「花の塔」になります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "파일 이름에서 '-'(대시) 기호 뒤의 텍스트를 나타냅니다.\n예를 들어 \"Never Gonna Give You Up - Rick Astley.mp3\"는 \"Rick Astley\"가 됩니다."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đại diện cho văn bản trong tên tệp sau ký hiệu '-' (dấu gạch ngang).\nVí dụ: \"Never Gonna Give You Up - Rick Astley.mp3\" sẽ thành \"Rick Astley\"."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "表示文件名中\"-\"（破折号）符号之后的文本。\n例如，\"Never Gonna Give You Up - Rick Astley.mp3\"将变为\"Rick Astley\"。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "表示檔案名稱中「-」（破折號）符號之後的文字。\n例如，「Never Gonna Give You Up - Rick Astley.mp3」將變為「Rick Astley」。"
          }
        }
      }
    },
    "TagEditor.Tokens.DashFront.Description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Represents the text in the file name before the '-' (dash) symbol.\nFor example, \"Rick Astley - Never Gonna Give You Up.mp3\" will result in \"Rick Astley\"."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ファイル名にある「-」の前のテキストに変換します。\n例えば、「さユり - 花の塔.mp3」の場合、「さユり」になります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "파일 이름에서 '-'(대시) 기호 앞의 텍스트를 나타냅니다.\n예를 들어 \"Never Gonna Give You Up - Rick Astley.mp3\"는 \"Never Gonna Give You Up\"가 됩니다."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đại diện cho văn bản trong tên tệp trước ký hiệu '-' (dấu gạch ngang).\nVí dụ: \"Never Gonna Give You Up - Rick Astley.mp3\" sẽ thành \"Never Gonna Give You Up\"."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "表示文件名中\"-\"（破折号）符号之前的文本。\n例如，\"Never Gonna Give You Up - Rick Astley.mp3\"将变为\"Never Gonna Give You Up\"。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "表示檔案名稱中「-」（破折號）符號之前的文字。\n例如，「Never Gonna Give You Up - Rick Astley.mp3」將變為「Never Gonna Give You Up」。"
          }
        }
      }
