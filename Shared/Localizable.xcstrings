    "TagEditor.Tip.Tokens.Text" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can use various tokens to make use of existing information (such as the MP3 file's filename) to edit track information.\nScroll down to see the tokens you can use."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "変換トークンを利用すると、ファイル名など既存の情報を利用し、より速くトラック情報を記入することができます。\n下にスクロールすると、利用できるトークンがご覧になれます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "트랙 이름이나 트랙 번호와 같은 기존 정보를 활용하기 위해 다양한 토큰을 사용할 수 있습니다."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn có thể sử dụng các token khác nhau để tận dụng thông tin hiện có (chẳng hạn như tên bản nhạc hoặc số bản nhạc)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您可以使用各种标记来利用现有信息（例如曲目名称或曲目编号）。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您可以使用各種變換符號來利用現有資訊（例如曲目名稱或曲目編號）。"
          }
        }
      }
    },
    "TagEditor.Tip.Tokens.Title" : {
      "localizations" : {
